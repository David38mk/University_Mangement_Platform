@model IEnumerable<University_Management_Platform.Models.Enrollment>

@{
    ViewData["Title"] = "My Courses";
}

<h2>My Courses</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">You are not enrolled in any courses yet.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Course</th>
                <th>Year</th>
                <th>Semester</th>
                <th>Status</th>
                <th>Grade</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model)
            {
                var active = e.FinishDate == null;

                <tr>
                    <td>
                        <div><b>@e.Course.Title</b></div>
                        <div class="text-muted" style="font-size: 0.9em;">
                            @e.Course.FirstTeacher?.FullName
                            @if (e.Course.SecondTeacher != null)
                            {
                                <span>, @e.Course.SecondTeacher.FullName</span>
                            }
                        </div>
                    </td>
                    <td>@(e.Year?.ToString() ?? "-")</td>
                    <td>@(e.Semester ?? "-")</td>
                    <td>
                        @if (active)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Finished</span>
                            <div class="text-muted" style="font-size: 0.85em;">
                                @(e.FinishDate?.ToString("yyyy-MM-dd"))
                            </div>
                        }
                    </td>
                    <td>@(e.Grade?.ToString() ?? "-")</td>
                    <td class="text-end">
                        <!-- You said you'll handle the enrollment page after -->
                        <a class="btn btn-sm btn-outline-primary"
                           asp-controller="Enrollments"
                           asp-action="Edit"
                           asp-route-id="@e.Id">
                            Open enrollment
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
