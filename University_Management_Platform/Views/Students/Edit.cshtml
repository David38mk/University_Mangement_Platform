@model University_Management_Platform.ViewModels.Students.StudentEditVM

@{
    ViewData["Title"] = "Edit";

    bool isAdmin = User.IsInRole("Admin");
    bool isStudent = User.IsInRole("Student");

    string postAction = isAdmin ? "Edit" : "EditMyProfile";
}

<h1>Edit</h1>

<h4>Student</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="@postAction" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @if (!string.IsNullOrWhiteSpace(Model.ExistingPhotoPath))
            {
                <img src="@Model.ExistingPhotoPath" style="max-height:160px;border-radius:8px;" />
            }
            <div class="form-group">
                <label asp-for="Photo" class="control-label"></label>
                <input asp-for="Photo" type="file" class="form-control" accept="image/*" />
                <span asp-validation-for="Photo" class="text-danger"></span>
            </div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="StudentId" class="control-label"></label>
                @if (isAdmin)
                {
                    <input asp-for="StudentId" class="form-control" />
                }
                else
                {
                    <input asp-for="StudentId" class="form-control" readonly/>
                }
                <span asp-validation-for="StudentId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FirstName" class="control-label"></label>
                @if (isAdmin)
                {
                    <input asp-for="FirstName" class="form-control" />
                }
                else
                {
                    <input asp-for="FirstName" class="form-control" readonly/>
                }
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LastName" class="control-label"></label>
                @if (isAdmin)
                {
                    <input asp-for="LastName" class="form-control" />
                }
                else
                {
                    <input asp-for="LastName" class="form-control" readonly/>
                }
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EnrollmentDate" class="control-label"></label>
                @if (isAdmin)
                {
                    <input asp-for="EnrollmentDate" class="form-control" />
                }
                else
                {
                    <input asp-for="EnrollmentDate" class="form-control" readonly/>
                }      
                <span asp-validation-for="EnrollmentDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AccquiredCredits" class="control-label"></label>
                @if (isAdmin)
                {
                    <input asp-for="AccquiredCredits" class="form-control" />
                }
                else
                {
                    <input asp-for="AccquiredCredits" class="form-control" readonly/>
                }
                <span asp-validation-for="AccquiredCredits" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CurrentSemester" class="control-label"></label>
                @if (isAdmin)
                {
                    <input asp-for="CurrentSemester" class="form-control" />
                }
                else
                {
                    <input asp-for="CurrentSemester" class="form-control" readonly />
                }
                <span asp-validation-for="CurrentSemester" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EducationLevel" class="control-label"></label>
                @if (isAdmin)
                {
                    <input asp-for="EducationLevel" class="form-control"/>
                }
                else
                {
                    <input asp-for="EducationLevel" class="form-control" readonly />
                }
                <span asp-validation-for="EducationLevel" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
@if (isAdmin)
{
    <div>
        <a asp-action="Index">Back to List</a>
    </div>
}
else
{
    <div>
        <a asp-action="MyProfile">Back to My Profile</a>
    </div>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
