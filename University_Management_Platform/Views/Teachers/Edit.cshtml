@model University_Management_Platform.ViewModels.Teachers.TeachersEditVM

@{
    ViewData["Title"] = "Edit Teacher";

    bool isAdmin = User.IsInRole("Admin");
    bool isTeacher = User.IsInRole("Teacher");

    // Teacher uses EditMyProfile, Admin uses Edit
    string postAction = isAdmin ? "Edit" : "EditMyProfile";

    // Optional: decide which fields teacher can change
    // If you want teacher to NOT change OfficeNumber/HireDate, set these to true
    bool teacherReadOnlyOfficeAndHire = true;
}

<h1>Edit</h1>
<h4>Teacher</h4>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="@postAction" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            @if (!string.IsNullOrWhiteSpace(Model.ExistingPhotoPath))
            {
                <img src="@Model.ExistingPhotoPath" style="max-height:160px;border-radius:8px;" class="mb-2" />
            }

            <div class="form-group">
                <label asp-for="Photo" class="control-label"></label>
                <input asp-for="Photo" type="file" class="form-control" accept="image/*" />
                <span asp-validation-for="Photo" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="FirstName" class="control-label"></label>
                @if (isAdmin || !teacherReadOnlyOfficeAndHire)
                {
                    <input asp-for="FirstName" class="form-control" />
                }
                else
                {
                    <input asp-for="FirstName" class="form-control" readonly/>
                    <div class="form-text">Only admin can change this.</div>
                }
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="LastName" class="control-label"></label>
                @if (isAdmin || !teacherReadOnlyOfficeAndHire)
                {
                    <input asp-for="LastName" class="form-control" />
                }
                else
                {
                    <input asp-for="LastName" class="form-control" readonly />
                    <div class="form-text">Only admin can change this.</div>
                }
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Degree" class="control-label"></label>
                @if (isAdmin || !teacherReadOnlyOfficeAndHire)
                {
                    <input asp-for="Degree" class="form-control" />
                }
                else
                {
                    <input asp-for="Degree" class="form-control" readonly />
                    <div class="form-text">Only admin can change this.</div>
                }
)
                <span asp-validation-for="Degree" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="AcademicRank" class="control-label"></label>
                @if (isAdmin || !teacherReadOnlyOfficeAndHire)
                {
                    <input asp-for="AcademicRank" class="form-control" />
                }
                else
                {
                    <input asp-for="AcademicRank" class="form-control" readonly />
                    <div class="form-text">Only admin can change this.</div>
                }
)
                <span asp-validation-for="AcademicRank" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="OfficeNumber" class="control-label"></label>
                @if (isAdmin || !teacherReadOnlyOfficeAndHire)
                {
                    <input asp-for="OfficeNumber" class="form-control" />
                }
                else
                {
                    <input asp-for="OfficeNumber" class="form-control" readonly />
                    <div class="form-text">Only admin can change this.</div>
                }
                <span asp-validation-for="OfficeNumber" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="HireDate" class="control-label"></label>
                @if (isAdmin || !teacherReadOnlyOfficeAndHire)
                {
                    <input asp-for="HireDate" class="form-control" type="date" />
                }
                else
                {
                    <input asp-for="HireDate" class="form-control" type="date" readonly />
                    <div class="form-text">Only admin can change this.</div>
                }
                <span asp-validation-for="HireDate" class="text-danger"></span>
            </div>

            <div class="form-group mt-2">
                @if (isAdmin || isTeacher)
                {
                    <input type="submit" value="Save" class="btn btn-primary" />
                }
            </div>
        </form>
    </div>
</div>

<div class="mt-2">
    @if (isAdmin)
    {
        <a asp-action="Index">Back to List</a>
    }
    else if (isTeacher)
    {
        <a asp-action="MyProfile">Back to My Profile</a>
    }
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
